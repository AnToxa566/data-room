{
  "permissions": {
    "allow": [
      "Bash(docker --version)",
      "Bash(docker info *)",
      "Bash(lsof -iTCP -sTCP:LISTEN -P)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:3000/)",
      "Bash(curl -s http://localhost:3000/)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:4200/)",
      "Bash(curl -s http://localhost:4200/)",
      "Bash(npx --no-install chromium-cli --version)",
      "Bash(command -v chromium-cli)",
      "Bash(find / -maxdepth 6 -iname \"*chromium-cli*\")",
      "Bash(node -e ' *)",
      "Bash(xargs -I{} basename {})",
      "Bash(xargs -I{} wc -l {})"
    ]
  },
  "enabledPlugins": {
    "nx@nx-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "www.google-analytics.com"
      ]
    }
  }
}
