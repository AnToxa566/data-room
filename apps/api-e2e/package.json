{
  "name": "@dataroom/api-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "tags": ["type:e2e", "scope:api"],
    "implicitDependencies": [
      "@dataroom/api"
    ],
    "targets": {
      "e2e": {
        "executor": "@nx/jest:jest",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "options": {
          "jestConfig": "apps/api-e2e/jest.config.cts",
          "passWithNoTests": true
        }
      }
    }
  },
  "dependencies": {
    "@dataroom/api": "0.0.1",
    "@dataroom/contracts": "0.0.1"
  },
  "devDependencies": {
    "@nestjs/config": "^4.0.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/testing": "^11.0.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2"
  }
}
