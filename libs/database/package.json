{
  "name": "@dataroom/database",
  "version": "0.0.1",
  "private": true,
  "type": "commonjs",
  "nx": {
    "tags": [
      "type:data",
      "scope:api"
    ],
    "targets": {
      "prisma-generate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma generate --config libs/database/prisma.config.ts"
        },
        "cache": false
      },
      "prisma-migrate-dev": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate dev --config libs/database/prisma.config.ts"
        },
        "cache": false
      },
      "prisma-migrate-deploy": {
        "executor": "nx:run-commands",
        "options": {
          "command": "prisma migrate deploy --config libs/database/prisma.config.ts"
        },
        "cache": false
      }
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "dotenv": "^17.4.2"
  }
}
