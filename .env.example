# ── Required everywhere (dev, CI, and production) ──────────────────────────────────
DATABASE_URL="postgresql://...:6543/postgres?pgbouncer=true"

JWT_SECRET=""
JWT_EXPIRES_IN="7d"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

WEB_APP_URL="http://localhost:4200"
CORS_ORIGINS="http://localhost:4200"

GCS_PROJECT_ID=""
GCS_BUCKET_NAME=""

# Not yet consumed by any code in apps/web — reserved for the SPA's API client. See
# README.md "Configure environment".
API_URL="http://localhost:3000/api"

# ── Local only — never set in production (see README.md "Configure environment") ───
# Migrations only, run from a dev machine against the direct connection — never read
# by the running API.
DIRECT_URL="postgresql://...:5432/postgres"

# Explicit service-account credentials — only needed where Application Default
# Credentials are unavailable (i.e. local dev). Leave BOTH unset in production: the
# API then signs via ADC + the IAM Credentials API instead, using the deployed
# service account's own identity. Setting only one fails validation at boot
# (env.schema.ts) — a half-configured credential is a misconfiguration, not a fallback.
GCS_CLIENT_EMAIL=""
GCS_PRIVATE_KEY=""

# ── Differs by environment — see README.md "Deployment" → cookies across origins ───
COOKIE_SECURE="false"
COOKIE_SAME_SITE="lax"
COOKIE_DOMAIN=""
# Cloud Run injects PORT at runtime — do not hardcode in production.
PORT="3000"

# ── Optional — every one of these has a sensible zod default (env.schema.ts). Left
# commented out: zod's .default() only applies when a key is absent, not when it's an
# empty string, so shipping these as `KEY=""` would fail validation instead of falling
# back. Uncomment to override. ──────────────────────────────────────────────────────
# MAX_FILE_SIZE_BYTES=104857600
# ALLOWED_MIME_TYPES="application/pdf"
# UPLOAD_URL_TTL_MINUTES=15
# DOWNLOAD_URL_TTL_MINUTES=15
# PENDING_TTL_MINUTES=60
# PENDING_SWEEP_INTERVAL_MINUTES=15
